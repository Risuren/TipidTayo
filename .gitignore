# ==========================================
# TipidTayo Root Gitignore
# Prevents any data leakage and excludes bulky/unneeded files
# ==========================================

# 1. Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.cert
auth.json

# 2. Bulky Dependencies (Installed via `npm install` and `composer install`)
vendor/
node_modules/
backend/vendor/
frontend/node_modules/

# 3. Build & Distribution Artifacts
dist/
dist-ssr/
frontend/dist/
backend/public/build/
backend/public/hot
backend/public/storage

# 4. Logs, Debug & Cache files (Prevents leaking URLs/tokens in logs)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache

# 5. OS & IDE Configuration
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json
.fleet/
.gemini/
.agents/
